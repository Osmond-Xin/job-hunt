# Core
JOB_HUNT_ENV=local
# CI/debug switches
JOB_HUNT_SKIP_CV_SYNC_CHECK=false
JOB_HUNT_WORKDAY_DEBUG=false

# LangSmith tracing switch
JOB_HUNT_LANGSMITH_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-hunt-dev

# Cheap model tier: Minimax
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat
MINIMAX_MODEL=
# Supported: minimax, anthropic, openai
MINIMAX_ENDPOINT_STYLE=minimax

# Optional Anthropic-compatible proxy for Minimax or other models.
# Keep real values in your local .env only.
MINIMAX_PROXY_TOKEN=
MINIMAX_PROXY_HEADER_NAME=X-Proxy-Token

# Optional Brave WebSearch provider.
# To enable: set web_search.provider=brave in config/settings.yml.
BRAVE_API_KEY=

# Optional Slack activity sink
JOB_HUNT_SLACK_WEBHOOK_URL=

# Optional Gmail paths. Keep real files out of git.
GOOGLE_APPLICATION_CREDENTIALS=
GMAIL_TOKEN_PATH=storage/oauth/gmail-token.json

# Optional overrides for the local-CLI LLM wrappers (scripts/*_llm.sh).
# JOB_HUNT_REDTEAM_CMD routes the red-team reviewer somewhere other than `mmx`
# — set it when mmx is out of quota, and keep it pointed at a different model
# from whatever config/settings.yml has writing the artifacts.
# JOB_HUNT_REDTEAM_CMD=./scripts/agy_llm.sh
#
# opencode has no usable default model and fails opaquely without one, so the
# wrapper always passes this. `opencode models` lists what is reachable;
# deepseek/* is metered per token and is not to be used. Sharing a model with
# the reviewer is only a problem for the tier that writes the artifacts.
# JOB_HUNT_OPENCODE_MODEL=minimax-cn-coding-plan/MiniMax-M3
#
# codex and agy pick their own defaults; set these only to override
# deliberately, and check the model name works first.
# JOB_HUNT_CODEX_MODEL=
# JOB_HUNT_AGY_MODEL=
