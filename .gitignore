# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
env/
dist/
build/
*.egg-info/

# Local environment and secrets
.env
.env.*
!.env.example
.claude/
config/*.local.yml
config/settings.yml
config/sites.yml
config/scheduler.yml
config/portals.yml
config/auth.yml
